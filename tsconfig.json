{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "Node16",
    "target": "ES2021",
    "lib": ["ES2021"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}
